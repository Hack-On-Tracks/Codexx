# --- Database (use your existing database) ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=skysnr_vision

# --- Auth ---
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false

# --- Frontend (CORS) ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Roboflow hosted inference (leave blank until you have real values) ---
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_CONFIDENCE=40
# Comma-separated class names, exactly as your model reports them
PERSON_CLASSES=person
OBSTACLE_CLASSES=
# "Nearby" = centre distance <= factor x the person box diagonal (image-space only)
PROXIMITY_FACTOR=3.0

# --- Storage ---
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

# Optional Roboflow object-detection integration for Mission Analysis (separate from AIDER classifier)
